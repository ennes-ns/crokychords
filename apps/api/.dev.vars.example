# Copy to .dev.vars (git-ignored) for `pnpm --filter @crokychords/api dev`. Local values only.
# Cloudflare Access does not run locally, so /api/* answers 401 without a valid Access JWT.
ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
ACCESS_AUD=replace-with-access-application-aud
ALLOWED_ORIGIN=http://localhost:5173
