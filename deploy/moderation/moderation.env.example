# Settings of the moderation job (docs/specs/moderation-v1.md §4.1). Copy to moderation.env
# (git-ignored), fill in, `chmod 600 moderation.env`. Never commit the filled-in file.

# The API base, e.g. https://<your app host>/api (https only).
MODERATION_API_BASE=

# Bearer token of the job routes; the same value as the Worker secret MODERATION_TOKEN.
MODERATION_TOKEN=

# Cloudflare Access service token (policy action "Service Auth" on the app's Access
# application). Both empty: no Access headers are sent.
MODERATION_ACCESS_CLIENT_ID=
MODERATION_ACCESS_CLIENT_SECRET=

# Issue number of the moderation inbox the daily digest comments on. Empty: no digest.
MODERATION_INBOX_ISSUE=

# Fine-grained GitHub token, this repository only, permission Issues: read and write (nothing
# else). Used only to comment the digest. Empty: the digest is skipped with a log line.
GITHUB_TOKEN=
